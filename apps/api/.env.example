# ─── Backend Environment Variables — apps/api ───────────────────────────────
# Copy this file to .env and fill in real values.
# In production (Railway), configure these as environment variables in the Railway dashboard.

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/queen_of_all_saints?schema=public

# ─── JWT Authentication ──────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-strong-access-secret-here-minimum-64-chars
JWT_REFRESH_SECRET=your-strong-refresh-secret-here-different-from-access

# ─── CORS ────────────────────────────────────────────────────────────────────
# Production: your Vercel domain (e.g., https://queen-of-all-saints.vercel.app)
FRONTEND_URL=http://localhost:3000

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Razorpay (Payment Gateway) ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-here

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Required for password reset and notification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@queenofallsaints.in
SMTP_PASS=your-app-password-here
SMTP_FROM="Queen of All Saints Parish <admin@queenofallsaints.in>"
