# ─── Queen of All Saints — Environment Variables Template ────────────────────
# Copy this file to .env.development, .env.test, .env.production
# NEVER commit files with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3001
APP_NAME="Queen of All Saints API"
CLIENT_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://qoas_user:qoas_password@localhost:5432/qoas_db?schema=public"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Generate strong random secrets in production
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_SECRET_64_CHARS_MINIMUM
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET_64_CHARS_MINIMUM

# ─── Redis (Session Store) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@queenofallsaints.in
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="Queen of All Saints <noreply@queenofallsaints.in>"

# ─── Storage ──────────────────────────────────────────────────────────────────
# Local storage path (development) or S3 bucket (production)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
# For production (S3):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=

# ─── Security ─────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
