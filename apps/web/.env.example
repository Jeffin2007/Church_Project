# ─── Frontend Environment Variables — apps/web ──────────────────────────────
# Copy this file to .env.local and fill in real values.

# API URL (development: http://localhost:3001/api/v1, production: Railway URL)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# App URL (used for CORS and OAuth callbacks in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Spreadsheet Activity Logger Webhook (from your Google Apps Script deployment)
NEXT_PUBLIC_APPS_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
