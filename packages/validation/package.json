{
  "name": "@qoas/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod validation schemas for Queen of All Saints",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@qoas/constants": "workspace:*",
    "@qoas/tsconfig": "workspace:*",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}
